<?xml version="1.0" encoding="utf-8"?>
<!-- Launch splash: the brand lockup centred on white.
     White in both light and dark (values-night/styles.xml points here too),
     because the lockup is navy on transparent and would vanish on a dark
     ground. A light splash into a light app is also the honest preview. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@android:color/white" />

    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/launch_image" />
    </item>
</layer-list>
